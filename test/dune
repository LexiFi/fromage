; The tests are in two aliases: [runtest], quick enough to be run after each
; change, and [runtest-full], which also runs the round-trips on all the
; sources of the repository, the fuzzing of all the configurations of
; fuzz_roundtrip.ml, and the coverage (see HACKING.md).
(alias
 (name runtest-full)
 (deps (alias_rec runtest)))

; Tokens of every kind, for random token sequences.
(library
 (name random_token)
 (modules random_token)
 (libraries ocst))

(test
 (name random_test)
 (modules random_test)
 (libraries random_token ocst))

(test
 (name parser_test)
 (modules parser_test)
 (libraries ocst compiler-libs.common))

; The messages of Ocst.Same_ast, in same_ast_test.expected.
(test
 (name same_ast_test)
 (modules same_ast_test)
 (libraries ocst))

(library
 (name roundtrip)
 (modules roundtrip)
 (libraries ocst unix compiler-libs.common))

(library
 (name lexer_check)
 (modules lexer_check)
 (libraries ocst compiler-libs.common))

; Sets the formatter which the round-trip checks check (see roundtrip.mli).
(library
 (name pretty_check)
 (modules pretty_check)
 (library_flags (-linkall))
 (libraries roundtrip ocst_pretty))

(executable
 (name codebase_roundtrip)
 (modules codebase_roundtrip)
 (libraries roundtrip lexer_check pretty_check unix compiler-libs.common))

(executable
 (name fuzz_roundtrip)
 (modules fuzz_roundtrip)
 (libraries random_token roundtrip pretty_check ocst unix compiler-libs.common))

; Sentences generated by ocamlgrammarfuzzer from ocaml/parsing/parser.mly:
; for [runtest], the exhaustive sentences without their mutants and the
; random ones, one entry point per rule, run in parallel.
(rule
 (alias runtest)
 (targets fuzz_quick_implementation.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer} --quick
     implementation))
   (diff fuzz_quick_implementation.expected %{targets}))))

(rule
 (alias runtest)
 (targets fuzz_quick_interface.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer} --quick
     interface))
   (diff fuzz_quick_interface.expected %{targets}))))

; All the configurations, for [runtest-full].
(rule
 (alias runtest-full)
 (targets fuzz_roundtrip.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}))
   (diff fuzz_roundtrip.expected %{targets}))))

; The lexer and parser round-trips, with the formatter, on the OCaml files of
; the repository.
(rule
 (alias runtest-full)
 (targets codebase_roundtrip.actual)
 (deps (source_tree ocamlformat_tests) (source_tree examples))
 (action
  (progn
   (with-stdout-to %{targets} (run ./codebase_roundtrip.exe))
   (diff codebase_roundtrip.expected %{targets}))))

; Deep fuzzing, only run with [dune build @ocst/test/fuzz-deep] (about 10
; minutes): every token inserted in every sentence of the exhaustive mode,
; long random sentences with more mutants (avoiding the productions which
; make most of them invalid, as [valid] in fuzz_roundtrip.ml), a few very long
; sentences (2000 and 20000 tokens, which also avoid the rare causes of
; rejection: MetaOCaml, string assignments, package types), and doc comments
; before every token.
(rule
 (alias fuzz-deep)
 (targets fuzz_deep_implementation.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     --every-token implementation --exhaust))
   (diff fuzz_deep_implementation.expected %{targets}))))

(rule
 (alias fuzz-deep)
 (targets fuzz_deep_interface.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     --every-token interface --exhaust))
   (diff fuzz_deep_interface.expected %{targets}))))

(rule
 (alias fuzz-deep)
 (targets fuzz_long_implementation.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     --mutants 10 implementation --seed 21 --count 30000 --length 120
     --avoid "let_binding_body: val_ident" --avoid "fun_expr: UNDERSCORE"
     --avoid "_: _* NONREC _* PLUSEQ _*" --avoid "_: _* NONREC _* COLONEQUAL _*"))
   (diff fuzz_long_implementation.expected %{targets}))))

(rule
 (alias fuzz-deep)
 (targets fuzz_long_interface.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     --mutants 10 interface --seed 21 --count 30000 --length 120
     --avoid "let_binding_body: val_ident" --avoid "fun_expr: UNDERSCORE"
     --avoid "_: _* NONREC _* PLUSEQ _*" --avoid "_: _* NONREC _* COLONEQUAL _*"))
   (diff fuzz_long_interface.expected %{targets}))))

