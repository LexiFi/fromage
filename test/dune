(rule
 (alias fuzz-deep)
 (targets fuzz_huge_2000_implementation.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     --mutants 5 implementation --seed 61 --count 1000 --length 2000
     --avoid "let_binding_body: val_ident" --avoid "fun_expr: UNDERSCORE"
     --avoid "_: _* NONREC _* PLUSEQ _*" --avoid "_: _* NONREC _* COLONEQUAL _*"
     --avoid METAOCAML_ESCAPE --avoid METAOCAML_BRACKET_OPEN
     --avoid "_: _* DOT LBRACKET _* LESSMINUS _*"
     --avoid "_: _* MODULE _* COLON module_type _*"
     --avoid "_: LPAREN MODULE _* module_type RPAREN"))
   (diff fuzz_huge_2000_implementation.expected %{targets}))))

(rule
