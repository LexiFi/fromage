; 25 sentences of a million tokens (about 4 minutes), which also avoid
; [(val e : S)] and [let%ext] in classes.
(rule
 (alias fuzz-deep)
 (targets fuzz_million_implementation.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     implementation --seed 71 --count 25 --length 1000000
     --avoid "let_binding_body: val_ident" --avoid "fun_expr: UNDERSCORE"
     --avoid "_: _* NONREC _* PLUSEQ _*" --avoid "_: _* NONREC _* COLONEQUAL _*"
     --avoid METAOCAML_ESCAPE --avoid METAOCAML_BRACKET_OPEN
     --avoid "_: _* DOT LBRACKET _* LESSMINUS _*"
     --avoid "_: _* MODULE _* COLON module_type _*"
     --avoid "_: LPAREN MODULE _* module_type RPAREN"
     --avoid "expr_colon_package_type: _* COLON _*"
     --avoid "expr_colon_package_type: _* COLONGREATER _*"
     --avoid "let_bindings(no_ext): _* PERCENT _*"))
   (diff fuzz_million_implementation.expected %{targets}))))

; 25 sentences of a million tokens (about 4 minutes), which also avoid
; [(val e : S)] and [let%ext] in classes.
(rule
 (alias fuzz-deep)
 (targets fuzz_million_interface.actual)
 (action
  (progn
   (with-stdout-to %{targets}
    (run ./fuzz_roundtrip.exe %{bin:menhir} %{bin:ocamlgrammarfuzzer}
     interface --seed 71 --count 25 --length 1000000
     --avoid "let_binding_body: val_ident" --avoid "fun_expr: UNDERSCORE"
     --avoid "_: _* NONREC _* PLUSEQ _*" --avoid "_: _* NONREC _* COLONEQUAL _*"
     --avoid METAOCAML_ESCAPE --avoid METAOCAML_BRACKET_OPEN
     --avoid "_: _* DOT LBRACKET _* LESSMINUS _*"
     --avoid "_: _* MODULE _* COLON module_type _*"
     --avoid "_: LPAREN MODULE _* module_type RPAREN"
     --avoid "expr_colon_package_type: _* COLON _*"
     --avoid "expr_colon_package_type: _* COLONGREATER _*"
     --avoid "let_bindings(no_ext): _* PERCENT _*"))
   (diff fuzz_million_interface.expected %{targets}))))

; The layout of the sources of OCST (see layout.ml), except the lexer
; (cst_lexer.mll), which ocst cannot read.
(library
 (name layout_rules)
 (modules layout_rules)
 (libraries ocst))

(executable
 (name layout)
 (modules layout)
 (libraries layout_rules))

(rule
 (alias runtest)
 (deps
  (glob_files
   ../ocst/{ocst,cst,doc_comments,parser,printer,same_ast,syntax_error,to_ast,token,token_position,token_stream}.{ml,mli})
  (glob_files *.ml)
  (glob_files errors/errors.ml)
  (glob_files doc_comments/doc_comments.ml)
  (glob_files coverage/{coverage_open,exclude_refill,uncovered}.ml)
  (glob_files ../pretty/*.ml)
  (glob_files ../pretty/{doc,ocst_pretty,syntax_layouts,trivia}.mli))
 (action (run ./layout.exe %{deps})))

; The layout of the sources formatted by Ocst_pretty (see pretty_test.ml):
; the sources of OCST, the examples, and the tests of the formatter (formatting/,
; where an input a.ml with an a.ml.expected is left as it is, and a.ml.expected
; is its formatted version).
(executable
 (name pretty_test)
 (modules pretty_test)
 (libraries layout_rules ocst ocst_pretty))

(rule
 (alias runtest)
 (targets pretty_test.actual)
 (deps
  (:sources
   (glob_files
    ../ocst/{ocst,cst,doc_comments,parser,printer,same_ast,syntax_error,to_ast,token,token_position,token_stream}.{ml,mli})
   (glob_files ../pretty/*.ml)
   (glob_files ../pretty/{doc,ocst_pretty,syntax_layouts,trivia}.mli)
   (glob_files examples/*.{ml,mli})
   (glob_files formatting/*.{ml,mli}))
  ; The formatted inputs, for the inputs left as they are.
  (glob_files formatting/*.expected))
 (action
  (progn
   (with-stdout-to %{targets} (run ./pretty_test.exe %{sources}))
   (diff pretty_test.expected %{targets}))))
