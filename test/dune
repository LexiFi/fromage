; The tests are in two aliases: [runtest], quick enough to be run after each
; change, and [runtest-full], which also runs the round-trips on all the
; sources of the repository, the fuzzing of all the configurations of
; fuzz_roundtrip.ml, and the coverage (see HACKING.md).

(alias
 (name runtest-full)
 (deps
  (alias_rec runtest)))

; Tokens of every kind, for random token sequences.

(library
 (name random_token)
 (modules random_token)
 (libraries ocst))

(test
 (name random_test)
 (package ocst)
 (modules random_test)
 (libraries random_token ocst))

(test
 (name parser_test)
 (package ocst)
 (modules parser_test)
 (libraries ocst compiler-libs.common))

; The messages of Ocst.Same_ast, in same_ast_test.expected.

(test
 (name same_ast_test)
 (package ocst)
 (modules same_ast_test)
 (libraries ocst))

(library
 (name roundtrip)
 (modules roundtrip)
 (libraries ocst unix compiler-libs.common))

(library
 (name lexer_check)
 (modules lexer_check)
 (libraries ocst compiler-libs.common))

; Sets the formatter which the round-trip checks check (see roundtrip.mli).

(library
 (name pretty_check)
 (modules pretty_check)
 (library_flags (-linkall))
 (libraries roundtrip ocst_pretty))

(executable
 (name codebase_roundtrip)
 (modules codebase_roundtrip)
 (libraries cmdliner roundtrip lexer_check pretty_check unix compiler-libs.common))

(executable
 (name fuzz_roundtrip)
 (modules fuzz_roundtrip)
 (libraries
  cmdliner
  random_token
  roundtrip
  pretty_check
  ocst
  unix
  compiler-libs.common))

; Sentences generated by ocamlgrammarfuzzer from parser.mly: for [runtest],
; the exhaustive sentences without their mutants and the random ones; for
; [runtest-full], all the configurations of fuzz_roundtrip.ml; for
; [fuzz-deep], the deep fuzzing ([deep_configurations]), too long for
; [runtest-full]. Each
; configuration runs in its rule, the exhaustive ones in parts, in parallel:
; the rules are generated in fuzz.inc (by [fuzz_roundtrip.exe --dune-rules
; test]), which [runtest] checks.

(include fuzz.inc)

(rule
 (with-stdout-to
  fuzz.inc.generated
  (run ./fuzz_roundtrip.exe --dune-rules test)))

(rule
 (alias runtest)
 (package fromage)
 (action
  (diff fuzz.inc fuzz.inc.generated)))

; The lexer and parser round-trips, with the formatter, on the OCaml files of
; the repository.

(rule
 (alias runtest-full)
 (package fromage)
 (targets codebase_roundtrip.actual)
 ; It reads the files of the repository from the source tree, as git lists
 ; them: run each time.
 (deps (universe))
 (action
  (progn
   (with-stdout-to
    %{targets}
    (run ./codebase_roundtrip.exe))
   (diff codebase_roundtrip.expected %{targets}))))

; The layout of the sources of OCST (see layout.ml), except the lexer
; (cst_lexer.mll), which ocst cannot read.

(library
 (name layout_rules)
 (modules layout_rules)
 (libraries ocst))

(executable
 (name layout)
 (modules layout)
 (libraries cmdliner layout_rules))

(rule
 (alias runtest)
 (package fromage)
 (deps
  (glob_files
   ../ocst/{ocst,cst,doc_comments,parser,printer,same_ast,syntax_error,text_diff,to_ast,token,token_position,token_stream}.{ml,mli})
  (glob_files *.ml)
  (glob_files errors/errors.ml)
  (glob_files doc_comments/doc_comments.ml)
  (glob_files coverage/{coverage_open,exclude_refill}.ml)
  (glob_files ../pretty/*.ml)
  (glob_files ../pretty/{doc,ocst_pretty,operator_classification,syntax_layouts,trivia}.mli))
 (action
  (run ./layout.exe %{deps})))

; The layout of the sources formatted by Ocst_pretty (see pretty_test.ml):
; the sources of OCST, the examples, and the tests of the formatter (formatting/,
; where an input a.ml with an a.ml.expected is left as it is, and a.ml.expected
; is its formatted version).

(executable
 (name pretty_test)
 (modules pretty_test)
 (libraries cmdliner layout_rules ocst ocst_pretty))

(rule
 (alias runtest)
 (package fromage)
 (targets pretty_test.actual)
 (deps
  (:sources
   (glob_files
    ../ocst/{ocst,cst,doc_comments,parser,printer,same_ast,syntax_error,text_diff,to_ast,token,token_position,token_stream}.{ml,mli})
   (glob_files ../pretty/*.ml)
   (glob_files ../pretty/{doc,ocst_pretty,operator_classification,syntax_layouts,trivia}.mli)
   (glob_files examples/*.{ml,mli})
   (glob_files formatting/*.{ml,mli}))
  ; The formatted inputs, for the inputs left as they are.
  (glob_files formatting/*.expected))
 (action
  (progn
   (with-stdout-to
    %{targets}
    (run ./pretty_test.exe %{sources}))
   (diff pretty_test.expected %{targets}))))

; [dune build] builds the tests, without running them: they run with
; [dune build @runtest] or the other aliases of the tests.

(alias
 (name default)
 (deps
  (alias check)
  (glob_files *.exe)))

; The kinds of infix operators, in operator_classification_test.expected.

(test
 (name operator_classification_test)
 (package fromage)
 (modules operator_classification_test)
 (libraries ocst_pretty))
