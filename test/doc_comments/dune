(executable
 (name doc_comments)
 (modules doc_comments)
 (libraries cmdliner roundtrip ocst compiler-libs.common))

; The doc comments of the files of cases, with the warnings about them.

(rule
 (alias runtest)
 (package ocst)
 (targets doc_comments.actual)
 (deps
  (source_tree cases))
 (action
  (progn
   (with-stdout-to
    %{targets}
    (run ./doc_comments.exe cases))
   (diff doc_comments.expected %{targets}))))

; [dune build] builds the tests, without running them: they run with
; [dune build @runtest] or the other aliases of the tests.

(alias
 (name default)
 (deps
  (alias check)
  (glob_files *.exe)))
