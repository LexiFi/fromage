(executable
 (name doc_comments)
 (modules doc_comments)
 (libraries roundtrip ocst compiler-libs.common))

; The doc comments of the files of cases, with the warnings about them.
(rule
 (alias runtest)
 (targets doc_comments.actual)
 (deps (source_tree cases))
 (action
  (progn
   (with-stdout-to %{targets} (run ./doc_comments.exe))
   (diff doc_comments.expected %{targets}))))
