(executable
 (name errors)
 (modules errors)
 (libraries roundtrip ocst str compiler-libs.common))

; The syntax errors on the files of cases, and the untested errors.
(rule
 (alias runtest)
 (targets errors.actual)
 (deps (source_tree cases) %{project_root}/ocst/parser.ml)
 (action
  (progn
   (with-stdout-to %{targets} (run ./errors.exe))
   (diff errors.expected %{targets}))))
