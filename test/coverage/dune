; Coverage of OCST by the tests of runtest-full (not the deep fuzzing): the sources
; of OCST are copied and instrumented with ppx_windtrap.coverage, with the test
; helpers, and the tests run against this copy. The coverage, by module, is
; compared with coverage.expected. Without ppx_windtrap, nothing here is built
; or run.

; [dune build] builds the instrumented tests, without running them.

(alias
 (name default)
 (enabled_if %{lib-available:ppx_windtrap.coverage})
 (deps
  (alias check)
  (glob_files *.exe)))

(copy_files#
 (files
  ../../ocst/{ocst,cst,doc_comments,parser,printer,same_ast,syntax_error,text_diff,to_ast,token,token_position,token_stream}.{ml,mli}))

; The lexer, without its refill branches, which no test can reach.

(rule
 (with-stdout-to
  cst_lexer.ml
  (run ./exclude_refill.exe %{dep:../../ocst/cst_lexer.ml})))

(executable
 (name exclude_refill)
 (modules exclude_refill)
 (libraries cmdliner str))

(copy_files#
 (files ../{roundtrip,random_token}.{ml,mli}))

; The lexer round-trip, with the compiler's [Parser] rather than OCST's.

(copy_files#
 (files ../lexer_check.{ml,mli}))

(copy_files#
 (files ../{fuzz_roundtrip,codebase_roundtrip,parser_test,random_test}.ml))

(copy_files#
 (files ../errors/errors.ml))

(library
 (name ocst_coverage)
 (optional)
 (modules
  ocst
  cst
  doc_comments
  cst_lexer
  parser
  printer
  same_ast
  syntax_error
  text_diff
  to_ast
  token
  token_position
  token_stream
  roundtrip
  random_token
  coverage_open)
 (preprocess
  (per_module
   ((pps ppx_windtrap.coverage)
    ocst
    cst
    doc_comments
    cst_lexer
    parser
    printer
    syntax_error
    to_ast
    token
    token_position
    token_stream)))
 (libraries compiler-libs.common unix))

(executables
 (names
  fuzz_roundtrip
  codebase_roundtrip
  parser_test
  random_test
  errors
  doc_comments_test)
 (modules
  fuzz_roundtrip
  codebase_roundtrip
  parser_test
  random_test
  errors
  doc_comments_test
  lexer_check)
 (optional)
 (flags
  (:standard -open Ocst_coverage.Coverage_open))
 (libraries cmdliner ocst_coverage str unix compiler-libs.common))

(rule
 (copy ../doc_comments/doc_comments.ml doc_comments_test.ml))

; The fuzzing, in parallel: one rule per configuration and part, as in the
; parent directory, generated in fuzz.inc (by [fuzz_roundtrip.exe
; --dune-rules coverage]), each writing its coverage.

(include fuzz.inc)

(rule
 (enabled_if %{lib-available:ppx_windtrap.coverage})
 (action
  (with-stdout-to
   fuzz.inc.generated
   (run ./fuzz_roundtrip.exe --dune-rules coverage))))

(rule
 (alias runtest)
 (package ocst)
 (enabled_if %{lib-available:ppx_windtrap.coverage})
 (action
  (diff fuzz.inc fuzz.inc.generated)))

; The tests write their coverage in this directory, one file per process
; ([WINDTRAP_COVERAGE_FILE]); their outputs are checked by the tests of the
; parent directory. [windtrap coverage] merges the files, and shows the lines
; which no test runs.

(rule
 (alias runtest-full)
 (package ocst)
 (enabled_if %{lib-available:ppx_windtrap.coverage})
 (targets coverage.actual)
 (deps
  (universe)
  ; The instrumented sources, which the report quotes.
  (glob_files *.ml)
  ; The coverage of the fuzzing, by the rules of fuzz.inc.
  (glob_files fuzz_*.coverage)
  codebase_roundtrip.exe
  parser_test.exe
  random_test.exe
  errors.exe
  doc_comments_test.exe
  (source_tree ../errors/cases)
  (source_tree ../doc_comments/cases)
  (source_tree ../examples)
  (source_tree ../ocamlformat_tests))
 (action
  (progn
   (setenv
    WINDTRAP_COVERAGE_FILE
    parser_test.coverage
    (ignore-stdout
     (run ./parser_test.exe)))
   (setenv
    WINDTRAP_COVERAGE_FILE
    random_test.coverage
    (ignore-stdout
     (run ./random_test.exe)))
   (setenv
    WINDTRAP_COVERAGE_FILE
    errors.coverage
    (ignore-stdout
     (run ./errors.exe ../errors/cases %{dep:../../ocst/parser.ml})))
   (setenv
    WINDTRAP_COVERAGE_FILE
    doc_comments_test.coverage
    (ignore-stdout
     (run ./doc_comments_test.exe ../doc_comments/cases)))
   (setenv
    WINDTRAP_COVERAGE_FILE
    codebase_roundtrip.coverage
    (ignore-stdout
     (run ./codebase_roundtrip.exe)))
   (with-stdout-to
    %{targets}
    (run %{bin:windtrap} coverage --color=never --show-uncovered .))
   (diff coverage.expected %{targets}))))
