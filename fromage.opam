# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A formatter of OCaml, built on ocst"
description:
  "A pretty printer of the concrete syntax trees of ocst, and the formatter of OCaml files which uses it, keeping the tokens, the comments and the blank lines of the source."
maintainer: ["Emile Trotignon <emile.trotignon@lexifi.com>"]
authors: ["Emile Trotignon <emile.trotignon@lexifi.com>"]
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.5" & < "5.6"}
  "ocst" {= version}
  "pretty_expressive"
  "cmdliner" {>= "2.0"}
  "menhir" {with-test}
  "ocamlgrammarfuzzer" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
pin-depends: [
  # Not in the opam repository.
  ["ocamlgrammarfuzzer.dev" "git+https://github.com/shogan-ai/ocamlgrammarfuzzer.git#f29aaf56469c7b6ba58346165edaea515d098455"]
]
