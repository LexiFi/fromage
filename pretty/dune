; A pretty printer for the CST of OCST (see ocst_pretty.mli), and a command
; formatting files, installed as [fromage]: [fromage FILE...] prints them
; formatted.

(library
 (name ocst_pretty)
 (public_name fromage)
 (modules ocst_pretty doc syntax_layouts trivia)
 (libraries ocst pretty_expressive))

(executable
 (name ocst_format)
 (public_name fromage)
 (package fromage)
 (modules ocst_format)
 (libraries cmdliner ocst ocst_pretty))
