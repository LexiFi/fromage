; A pretty printer for the CST of OCST (see ocst_pretty.mli), and a command
; formatting files: [ocst_format.exe FILE...] prints them formatted.

(library
 (name ocst_pretty)
 (modules ocst_pretty doc syntax_layouts trivia)
 (libraries ocst pretty_expressive))

(executable
 (name ocst_format)
 (modules ocst_format)
 (libraries ocst ocst_pretty))
