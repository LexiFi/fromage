opam-version: "2.0"
synopsis: "A lossless concrete syntax tree of OCaml, with its parser"
description:
  "A parser of OCaml which keeps every token, comment and blank line of the source, and prints it back unchanged. Its syntax tree converts to the compiler's Parsetree."
maintainer: ["Emile Trotignon <emile.trotignon@lexifi.com>"]
authors: ["Emile Trotignon <emile.trotignon@lexifi.com>"]
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.5" & < "5.6"}
  "cmdliner" {with-test & >= "2.0"}
  "menhir" {with-dev-setup}
  "ocamlgrammarfuzzer" {with-dev-setup}
  "ppx_windtrap" {with-dev-setup & >= "0.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
pin-depends: [
  # Not in the opam repository.
  ["ocamlgrammarfuzzer.dev" "git+https://github.com/shogan-ai/ocamlgrammarfuzzer.git#f29aaf56469c7b6ba58346165edaea515d098455"]
]
